/target
# Keep the workspace dependency graph pinned for reproducible release and CI
# evidence. Library-only crates may ignore their lockfile, but this repository
# ships binaries and release artifacts.
!Cargo.lock
.DS_Store
fuzz/target
interop/python/__pycache__/

# Development material retained locally but not shipped in the product tree.
/docs/
/spec/
/prototype/
/fuzz/
/interop/
/scripts/
/tests/
/umeps/

# Published interoperability conformance artifacts. These are consumed by
# the independent protocol-vector CI job rather than treated as local plans.
!/interop/
!/interop/python/
!/interop/python/requirements.txt
!/interop/python/test_vectors.py
!/interop/python/verify_vectors.py
!/interop/vectors/
!/interop/vectors/README.md
!/interop/vectors/ump1-v0.1.json
interop/python/live_runner.py
interop/python/test_live_runner.py
interop/README.md
interop/python/__pycache__/
